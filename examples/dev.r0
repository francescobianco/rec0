# Project used by `make start`: real webcam and microphone, full-screen close-up.
project: dev

video:
  resolution: 1920x1080
  fps: 30

camera:
  bubble:
    size: 267
  device: default
  closeup: fullscreen
  overlay:
    position: bottom-right
    width: 240

screen:
  monitor: primary

windows:
  - match: chrome
  - match: firefox
  - match: gnome-terminal
  - match: jetbrains-webstorm
  - match: pragma-chess

audio:
  processing: auto
  microphone: default
  desktop: true              # what you hear, on its own track, kept as heard

output:
  directory: ~/Videos/rec0/dev
