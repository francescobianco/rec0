project: tutorial-python

video:
  resolution: 1920x1080
  fps: 30
  transition: 0.3

# Virtual desktop: a colour (#RRGGBB) or an image (path relative to this file).
# When omitted, assets/background.jpg is used.
# background: wallpaper.jpg

# Close-up while rec0 (or a window not listed below) has focus.
camera:
  device: default
  closeup: fullscreen
  overlay:
    position: bottom-right
    width: 320

# Share scene while one of these windows has focus.
screen:
  monitor: primary
  margin: 40

windows:
  - match: Firefox                 # every Firefox window
  - match: "Python 3 documentation"  # only the tab with this title (any browser)
  - match: gnome-terminal

audio:
  microphone: default
  desktop: false

launch:
  - command: firefox https://docs.python.org/3/
  - command: gnome-terminal
    cwd: ~/Develop
    delay: 1

output:
  directory: ~/Videos/Tutorial
  filename: "{project}-{timestamp}.mp4"
  format: mp4
