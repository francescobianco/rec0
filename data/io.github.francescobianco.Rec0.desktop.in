[Desktop Entry]
Name=rec0
GenericName=Video Recorder
Comment=Record screencasts and webcam videos from declarative project files
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords=screencast;screen;recorder;record;webcam;camera;video;tutorial;capture;
Exec=rec0 %F
Icon=io.github.francescobianco.Rec0
Terminal=false
Type=Application
Categories=GNOME;GTK;AudioVideo;Video;Recorder;
MimeType=application/yaml;application/x-yaml;
StartupNotify=true
StartupWMClass=io.github.francescobianco.Rec0
DBusActivatable=true
X-GNOME-UsesNotifications=true
